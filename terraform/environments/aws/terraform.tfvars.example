# Copie para terraform.tfvars (ignorado pelo git) e preencha com os valores reais.

aws_region  = "us-east-1"
environment = "production"
app_name    = "gomech"

db_password         = "troque-por-uma-senha-forte"
jwt_secret          = "troque-por-uma-chave-hex-de-256-bits"   # openssl rand -hex 32
service_auth_secret = "troque-por-um-segredo-compartilhado"    # openssl rand -hex 32

gemini_api_key = ""   # vazio = serviço de IA com provider mock (sem custo)

google_client_id     = ""
google_client_secret = ""

backend_image    = "public.ecr.aws/seu-alias/gomech-backend:latest"
ai_service_image = "public.ecr.aws/seu-alias/gomech-ai-service:latest"
