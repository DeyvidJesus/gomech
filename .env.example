# Configuração da stack local (docker compose). Copie para .env: cp .env.example .env
# Os valores abaixo servem apenas para desenvolvimento. Nunca versione o .env.

COMPOSE_PROJECT_NAME=gomech

# PostgreSQL
POSTGRES_DB=gomech_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Portas publicadas no host
BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_PORT=8000

# Backend
SPRING_PROFILES_ACTIVE=local
# Chave HMAC-SHA256 dos access tokens. Em produção: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Sem chave do Pagar.me, o gateway de pagamento roda em modo simulado
PAGARME_MOCK_ENABLED=true

# Google OAuth 2.0 (opcional; credenciais do Google Cloud Console)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# AI Service
AI_SERVICE_NAME=gomech-ai
# Segredo compartilhado entre o AI Gateway do backend e o AI Service
AI_SERVICE_AUTH_SECRET=gm-ai-local-dev-secret
# mock | gemini | openai (mock não tem custo e é determinístico)
AI_DEFAULT_PROVIDER=mock
GEMINI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
