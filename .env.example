# Configuração da stack local (docker compose). Copie para .env: cp .env.example .env
# Os valores abaixo servem apenas para desenvolvimento. Nunca versione o .env.

COMPOSE_PROJECT_NAME=gomech

# PostgreSQL
POSTGRES_DB=gomech_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Portas publicadas no host
BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_PORT=8000

# Backend
SPRING_PROFILES_ACTIVE=local
# Chave HMAC-SHA256 dos access tokens. Este valor é público e só é aceito com o profile local;
# nos outros profiles o backend não sobe sem um segredo próprio (openssl rand -hex 32).
JWT_SECRET=e39125fc5add83ed45a24dbe4fa687d1f10bbefb5fb66d1eb44c48180325c342
# Sem chave do Pagar.me, o gateway de pagamento roda em modo simulado
PAGARME_MOCK_ENABLED=true

# Google OAuth 2.0 (opcional; credenciais do Google Cloud Console)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# AI Service
AI_SERVICE_NAME=gomech-ai
# Ambiente do AI Service. local, development, dev e test aceitam o segredo de desenvolvimento abaixo;
# qualquer outro valor exige um segredo próprio com pelo menos 32 caracteres.
AI_ENVIRONMENT=local
# Segredo compartilhado entre o AI Gateway do backend e o AI Service (valor público, só para uso local)
AI_SERVICE_AUTH_SECRET=gm-ai-local-dev-secret
# mock | gemini | openai; mock não tem custo e mantém respostas determinísticas
# No estado atual, Gemini usa o modelo externo em /chat; outras capacidades ainda usam mock
AI_DEFAULT_PROVIDER=mock
GEMINI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
