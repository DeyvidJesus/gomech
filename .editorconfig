root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{java,kt,py,yml,yaml,json,ts,tsx,js,jsx,css,scss,html,xml,sql,sh}]
indent_style = space

[*.java]
indent_size = 4

[*.py]
indent_size = 4
